---
/**
 * 文明卡片网格：首页主推模块。
 *
 * 数据源：entity-index.json 中 type=civilization 的条目。
 * 每个 civilization 通过 connections 聚合 dynasty/person/place，
 * 反向关系（哪些实体属于该文明）本应走 graph.json 的 reverseIndex，
 * 但当前 graph-builder 的 reverseIndex 尚为 TODO，故卡片暂仅展示
 * civilization 自身的 title/regions/start/end，待反向索引就绪后再补"代表实体"。
 *
 * 空态：entity-index 无 civilization 时显示建设中提示，保持版面完整。
 */
import { STRINGS } from './strings.ts';
import type { HomeLocale } from './strings.ts';
import type { EntityIndex, EntityIndexEntry } from '../../lib/types.ts';
import { entityUrl } from '../../lib/schemas/constants.ts';

interface Props {
  locale: HomeLocale;
  index: EntityIndex;
}

const { locale, index } = Astro.props;
const t = STRINGS[locale];

const civilizations: EntityIndexEntry[] = Object.values(index).filter(
  (e) => e.type === 'civilization',
);

/** 格式化年份区间：公元前为负数，按 locale 渲染。 */
function formatYearRange(
  start: number | undefined,
  end: number | undefined,
  loc: HomeLocale,
): string | undefined {
  if (start === undefined && end === undefined) return undefined;
  const bc = loc === 'zh' ? '公元前 ' : '';
  const ad = loc === 'zh' ? '公元 ' : '';
  const fmt = (y?: number) => {
    if (y === undefined) return '?';
    return y < 0 ? `${bc}${Math.abs(y)}` : `${ad}${y}`;
  };
  return `${fmt(start)} — ${fmt(end)}`;
}

interface Card {
  id: string;
  title: string;
  href: string;
  range?: string;
  regions: string[];
}

const cards: Card[] = civilizations.map((c) => {
  const start = c.start;
  const end = c.end;
  return {
    id: c.id,
    title: c.title,
    href: entityUrl('civilization', locale, c.id),
    range: formatYearRange(start, end, locale),
    regions: c.regions,
  };
});
---

<section class="civ" aria-labelledby="civ-title">
  <div class="civ__inner">
    <header class="civ__head">
      <h2 id="civ-title" class="civ__title">{t.civilizationsTitle}</h2>
      <p class="civ__subtitle">{t.civilizationsSubtitle}</p>
    </header>

    {
      cards.length === 0 ? (
        <p class="civ__empty">{t.empty}</p>
      ) : (
        <ul class="civ__grid">
          {cards.map((c) => (
            <li class="civ__card-wrap">
              <a class="civ__card" href={c.href}>
                <h3 class="civ__card-title">{c.title}</h3>
                {c.range && <p class="civ__card-range">{c.range}</p>}
                {c.regions.length > 0 && (
                  <ul class="civ__card-regions">
                    {c.regions.map((r) => (
                      <li class="civ__chip">{r}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .civ {
    padding: 4rem 1.5rem;
  }

  .civ__inner {
    max-width: 75rem;
    margin: 0 auto;
  }

  .civ__head {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .civ__title {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h2, 1.75rem);
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .civ__subtitle {
    margin: 0;
    font-size: var(--sl-text-body, 1.05rem);
    color: var(--sl-color-text);
  }

  .civ__empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-body, 1.05rem);
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .civ__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .civ__card-wrap {
    list-style: none;
  }

  .civ__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: var(--sl-color-bg-sidebar, var(--sl-color-gray-6));
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    text-decoration: none;
    transition:
      transform 0.12s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .civ__card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
    box-shadow: var(--sl-shadow-md, 0 4px 12px rgba(0, 0, 0, 0.25));
  }

  .civ__card-title {
    margin: 0;
    font-size: var(--sl-text-xl, 1.3rem);
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .civ__card-range {
    margin: 0;
    font-size: var(--sl-text-sm, 0.85rem);
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
  }

  .civ__card-regions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .civ__chip {
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: var(--sl-text-2xs, 0.75rem);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
</style>
